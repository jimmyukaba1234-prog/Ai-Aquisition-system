# Copy to .env.local for local builds, and add the same names in Vercel -> Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Groq (server only - never exposed to the browser). Free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
